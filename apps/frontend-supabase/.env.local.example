# --- Supabase: браузер (публичный read + Realtime + мутации через RLS) ---
# Dashboard → Settings → API → Project URL и publishable key (sb_publishable_*)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY
# (альтернативный старый ключ — если используете anon вместо publishable)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service-role ключ НЕ нужен: мутации идут через RLS + auth.uid().
# (SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY не требуются.)
