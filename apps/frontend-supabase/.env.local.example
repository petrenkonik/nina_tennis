# URL приложения (next-auth)
NEXTAUTH_URL=http://localhost:3120

# Секрет подписи next-auth (сгенерируйте: openssl rand -base64 32)
NEXTAUTH_SECRET=

# --- Supabase: сервер (только для Server Actions/Route Handlers, БЕЗ NEXT_PUBLIC_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Supabase: браузер (публичный read + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
